#########################################################################
# If you edit this file, delete sdkconfig.xteink_x4 to let it rebuild.
#########################################################################

#
# Arduino
#
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000

#
# Flash
#
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

#
# Power management — real light sleep with BLE alive
#
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

#
# Bluetooth (NimBLE)
#
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y

#
# PHY power down when idle
#
CONFIG_ESP_PHY_MAC_BB_PD=y

#
# Task Watchdog — 30s timeout + panic-reboot so a hung loop task recovers cleanly.
# (IDF default here was 5s with panic off, which only logs and never reboots.)
# 30s clears the longest blocking loop op (the 10s e-ink BUSY waits).
#
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y

